# Firebase 설정
# Firebase Console에서 프로젝트를 생성한 후 아래 값들을 입력하세요.
# https://console.firebase.google.com/

REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Firebase 설정 방법:
# 1. Firebase Console (https://console.firebase.google.com/)에서 새 프로젝트 생성
# 2. Authentication > Sign-in method에서 Google 로그인 활성화
# 3. Firestore Database 생성 (테스트 모드로 시작 가능)
# 4. 프로젝트 설정 > 일반 > 내 앱에서 웹 앱 추가
# 5. 생성된 firebaseConfig 값을 위 변수에 입력
# 6. 이 파일을 .env로 복사하여 사용

# Firestore 보안 규칙 (Firestore > 규칙에 추가):
# rules_version = '2';
